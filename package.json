{
  "name": "@rt-boo/kf-style",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Korn Ferry-inspired slide and UI design system",
  "scripts": {
    "slides:qa": "node generator/qa-deck.mjs generator/examples/kf-proposal.json",
    "slides:build:example": "node generator/render-deck.mjs generator/examples/kf-proposal.json generator/output/kf-proposal.pptx",
    "slides:gallery": "node generator/gallery.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run slides:qa",
    "build": "npm run slides:build:example"
  },
  "dependencies": {
    "pptxgenjs": "4.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
